    {
      "id": "copilot-team-plugins",
      "title": "Copilot 团队插件默认配置正式可用",
      "titleId": "copilot-team-plugins-title",
      "paragraphs": [
        {
          "text": "Business 和 Enterprise 团队维护者或组织所有者可统一选择 Agent Plugins，覆盖 VS Code、Copilot app 和 CLI 的团队直接成员。",
          "variant": ""
        },
        {
          "text": "减少重复配置，但子团队不继承，组织政策仍优先；成员仅在允许时可关闭默认插件，不是个人订阅的新功能。",
          "variant": "takeaway"
        }
      ],
      "sourceDate": "2026-11-18",
      "dateLabel": "11月18日 · 公告／进展",
