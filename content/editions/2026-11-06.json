    {
      "id": "langfuse-gateway",
      "title": "Langfuse AI Gateway 开放费用追踪测试",
      "titleId": "langfuse-gateway-title",
      "paragraphs": [
        {
          "text": "AI Gateway 进入公开 beta，可通过更换 base URL 和 API key 接入 OpenAI 或 Anthropic 原生接口，自动记录调用并按用户、密钥和模型统计费用。",
          "variant": ""
        },
        {
          "text": "适合小团队集中管理编码代理的上游密钥与成本；它不转换不同 API 格式，也不意味着请求在本地处理。",
          "variant": "takeaway"
        }
      ],
      "sourceDate": "2026-11-04",
