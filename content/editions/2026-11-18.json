    {
      "id": "copilot-adaptive",
      "title": "Copilot 代码审阅可按 PR 风险分配推理力度",
      "titleId": "copilot-adaptive-title",
      "paragraphs": [
        {
          "text": "Adaptive 公开预览在 Lite、Balanced、Max 中按 PR 复杂度和风险选择审阅力度，并受管理员上限约束；另加入公共仓库跨库上下文。",
          "variant": ""
        },
        {
          "text": "默认依然是 Balanced。新能力仍为预览，跨库上下文当前限公共仓库，不能当作已自动开启或替代人工审阅。",
          "variant": "takeaway"
        }
      ],
      "sourceDate": "2026-11-17",
      "dateLabel": "11月17日 · 公告／发布",
      "eventDate": "2026-11-17",
