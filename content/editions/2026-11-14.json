          "label": "官方发布说明",
          "url": "https://github.com/pnpm/pnpm/releases/tag/v12.21.0",
          "icon": false
        }
      ]
    },
    {
      "id": "copilot-dec-retirement",
      "title": "Copilot 预告 12月14日退役六款旧模型",
      "titleId": "copilot-dec-retirement-title",
      "paragraphs": [
        {
          "text": "GitHub 将于12月14日移除 Claude Fable 5、Haiku 4.5、Gemini 3.8 Flash、Gemini 4 Argon、Grok 4.6 和 Kimi K3。",
          "variant": ""
        },
        {
          "text": "固定模型的工作流应提前测试替代选项；个人年度订阅的 Haiku 4.5 有例外，Kimi K3 的建议替代仍待公布。",
          "variant": "takeaway"
        }
      ],
      "sourceDate": "2026-11-13",
      "dateLabel": "11月13日 · 退役预告",
      "eventDate": "2026-12-14",
