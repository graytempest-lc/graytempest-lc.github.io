    {
      "id": "crowdstrike-zscaler",
      "title": "CrowdStrike 拟以全股票交易收购 Zscaler",
      "titleId": "crowdstrike-zscaler-title",
      "paragraphs": [
        {
          "text": "双方公告给出的交易企业价值约为 439 亿美元，计划把端点安全和零信任网络能力纳入同一集团。",
          "variant": ""
        },
        {
          "text": "预计在 CrowdStrike 2028 财年下半年完成，仍需满足审批等交割条件。现有客户不能把公告视作产品已经合并。",
          "variant": "takeaway"
        }
      ],
