    {
      "id": "github-issue-status-boards",
      "title": "GitHub 公开预览 Issue 状态与仓库看板",
      "titleId": "github-issue-status-boards-title",
      "paragraphs": [
        {
          "text": "GitHub 提供七种内置 Issue 状态，仓库看板可通过拖动或 API 更改状态，关联 PR 也能触发自动更新。",
          "variant": ""
        },
        {
          "text": "适合在单仓库内跟踪工作流，但仍是公测，不等同于跨仓库 GitHub Projects 或现有项目工作流的全面替代。",
          "variant": "takeaway"
        }
      ],
      "sourceDate": "2026-11-23",
      "dateLabel": "11月23日 · 公开预览",
      "eventDate": "2026-11-23",
      "sourcePublishedAt": "2026-11-23",
