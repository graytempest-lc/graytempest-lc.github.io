      ]
    },
    {
      "id": "supabase",
      "title": "Supabase Realtime 修复节点断连时的订阅保留",
      "titleId": "supabase-title",
      "paragraphs": [
        {
          "text": "Realtime 2.153.2 修正订阅节点断开连接时 Postgres Changes 订阅未能保留的问题。",
          "variant": ""
        },
        {
          "text": "依赖数据库变更流的部署可重点回归节点掉线与重连场景；本次发布是定向修复，不代表所有断线恢复问题都已解决。",
          "variant": "takeaway"
        }
      ],
      "sourceDate": "2026-11-04",
