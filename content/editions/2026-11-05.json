    {
      "id": "dharma",
      "title": "Dharma 用 2B 模型从文档图像提取结构化字段",
      "titleId": "dharma-title",
      "paragraphs": [
        {
          "text": "Dharma 展示基于 2B OCR 模型与 LoRA 的字段提取器，可按给定结构输出 JSON，也可自动识别页面中的字段。",
          "variant": ""
        },
        {
          "text": "效果与成本来自厂商自测，成本按单张 L40S 的 GPU 时间估算，不是服务报价；原文未明确提供该提取器的开放权重。",
          "variant": "takeaway"
        }
      ],
      "sourceDate": "2026-11-04",
      "dateLabel": "11月4日 · 厂商技术报告",
      "eventDate": null,
      "sourcePublishedAt": null,
