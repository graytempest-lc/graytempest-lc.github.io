    {
      "id": "lfm3",
      "title": "LFM3：面向本地任务的轻量模型",
      "titleId": "lfm3-title",
      "paragraphs": [
        {
          "text": "Liquid AI 发布首批约 2B 参数模型，覆盖文本、视觉、音频、全模态与决策任务。",
          "variant": "dek"
        },
        {
          "text": "分类、信息提取和语音处理，多了面向专门任务的轻量选择。实际部署仍需确认模型许可、推理框架与设备支持。",
          "variant": ""
        }
      ],
      "sourceDate": "2026-10-27",
      "dateLabel": "10 月 27 日发布",
      "eventDate": null,
      "sourcePublishedAt": null,
      "sources": [
