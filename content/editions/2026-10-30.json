      ]
    },
    {
      "id": "replica",
      "title": "GitHub 开源原型工具 Replica",
      "titleId": "replica-title",
      "paragraphs": [
        {
          "text": "基于团队现有组件、交互规范和文档生成 AI 原型，MIT 许可，可本地制作交互原型，也可选自托管 Hub 收集反馈。",
          "variant": ""
        },
        {
          "text": "适合已有组件库的开发者和小团队，减少生成页面时样式另起一套的问题。",
          "variant": "takeaway"
        }
      ],
      "sourceDate": "2026-10-28",
      "dateLabel": "10 月 28 日发布 · 补充",
      "eventDate": null,
      "sourcePublishedAt": null,
      "sources": [
