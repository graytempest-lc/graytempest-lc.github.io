    {
      "id": "copilot-review-org-billing",
      "title": "GitHub 将调整 Copilot 代码审查的默认付款方",
      "titleId": "copilot-review-org-billing-title",
      "paragraphs": [
        {
          "text": "在采用 Copilot Business 或 Enterprise 的组织里，若未设置这项策略，持有付费许可的成员产生的可计费审查，从 12 月 30 日起默认计入仓库所属组织。",
          "variant": ""
        },
        {
          "text": "仅在对应组织启用按量付费且审查符合计费条件时适用。希望保持由成员承担的组织应改选 Member；这不是个人套餐调价。",
          "variant": "takeaway"
        }
      ],
      "sourceDate": "2026-11-25",
      "dateLabel": "11月25日 · 公告／发布",
      "eventDate": "2026-11-25",
      "sourcePublishedAt": "2026-11-25",
