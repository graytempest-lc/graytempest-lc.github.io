    {
      "id": "fedora",
      "title": "Fedora 45 发布，升级前留意旧 VPN 插件",
      "titleId": "fedora-title",
      "paragraphs": [
        {
          "text": "安装器整合 Stratis，RPM 6.1 默认验证软件包签名；旧 vpnc 和 fortisslvpn 插件退役。",
          "variant": ""
        },
        {
          "text": "计划升级工作机时，应先检查现有 VPN 连接是否依赖这些插件，避免升级后远程访问中断。",
          "variant": "takeaway"
        }
      ],
      "sourceDate": "2026-11-03",
      "dateLabel": "11月3日 · 发布",
      "eventDate": null,
      "sourcePublishedAt": null,
