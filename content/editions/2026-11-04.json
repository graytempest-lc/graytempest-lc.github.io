    {
      "id": "etude",
      "title": "ETUDE 研究工具升级后的信任缺口",
      "titleId": "etude-title",
      "paragraphs": [
        {
          "text": "论文研究工具更新后继续沿用旧权限与信任的供应链风险：工具实现改变，模型可见的交互未必同步暴露变化。",
          "variant": ""
        },
        {
          "text": "研究使用自建工具和受控实验，不代表相关真实项目已遭攻击；工具升级后的复核与执行时约束值得关注。",
          "variant": "takeaway"
        }
      ],
