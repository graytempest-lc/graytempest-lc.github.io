    {
      "id": "botpsy-local-agent",
      "title": "BotPsy 以 0.8B 参数探索本地工具调用",
      "titleId": "botpsy-local-agent-title",
      "paragraphs": [
        {
          "text": "Tether AI Research 发布基于 Qwen3.5-0.8B 的 BotPsy，提供 Apache 2.0 权重、BF16、8-bit 及 llama.cpp 用 GGUF，面向低至中等难度的工具调用任务。",
          "variant": ""
        },
        {
          "text": "适合手机或个人电脑上的小型智能体原型，但仍需应用提供并执行工具。训练测试以英语为主；官方提示不用于高风险自动决策，其提示注入测试仍有31%不安全率。",
          "variant": "takeaway"
        }
      ],
      "sourceDate": "2026-11-11",
      "dateLabel": "11月11日 · 开放权重",
      "eventDate": "2026-11-11",
      "sourcePublishedAt": null,
