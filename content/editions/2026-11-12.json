    {
      "id": "qwen4-max-preview",
      "title": "Qwen4-Max 开放限时预览",
      "titleId": "qwen4-max-preview-title",
      "paragraphs": [
        {
          "text": "QwenCloud 上线 qwen4-max-preview，提供百万 token 上下文、图像与视频理解、工具调用和结构化输出。目前仅通过 Token Plan 提供，不支持按量付费；预览期为北京时间11月11日10:00至25日24:00，随后退役。",
          "variant": ""
        },
        {
          "text": "适合测试多模态编码与智能体流程，不宜绑定为长期生产依赖。max_tokens 与 max_completion_tokens 都包含思考和最终答案，沿用旧预算可能截断回答。",
          "variant": "takeaway"
        }
      ],
      "sourceDate": "2026-11-11",
      "dateLabel": "11月11日 · 预览",
      "eventDate": "2026-11-11",
      "sourcePublishedAt": null,
