    {
      "id": "sensenova-u16",
      "title": "商汤 SenseNova U1.6 开放图像生成与编辑模型",
      "titleId": "sensenova-u16-title",
      "paragraphs": [
        {
          "text": "模型可根据提示查看并重绘图中的文字，开放权重采用 Apache 2.0，并提供 Native、GGUF 与 4 步／8 步 LoRA 加速选项。",
          "variant": ""
        },
        {
          "text": "官方对 Native 和 GGUF 的验证聚焦文生图，不应据此保证所有编辑任务的效果，也不能从模型名直接推算显存。",
          "variant": "takeaway"
        }
      ],
