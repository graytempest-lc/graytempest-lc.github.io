    {
      "id": "genie4-api",
      "title": "Genie 4 接入 Gemini API 与 AI Studio",
      "titleId": "genie4-api-title",
      "paragraphs": [
        {
          "text": "11月18日发布的 Genie 4 于19日开放此次 API 接入，支持文本或参考图生成带原生音频的连续 720p、24fps 世界，并用键盘和提示改变场景。",
          "variant": ""
        },
        {
          "text": "可用于交互原型探索；此次新进展是开发者入口，演示效果不代表已验证的机器人仿真能力。",
          "variant": "takeaway"
        }
      ],
      "sourceDate": "2026-11-19",
