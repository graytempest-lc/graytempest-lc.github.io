    {
      "id": "azure-live-migration",
      "title": "Azure DevOps 到 GitHub 的持续同步迁移正式上线",
      "titleId": "azure-live-migration-title",
      "paragraphs": [
        {
          "text": "Enterprise Live Migrations 支持 Azure DevOps Services 迁入带数据驻留的 GitHub Enterprise Cloud，迁移中持续同步 Git 历史、分支、标签与 PR。",
          "variant": ""
        },
        {
          "text": "最终切换仍有短暂只读窗口；不支持直接从 Azure DevOps Server 迁移，工作项、流水线定义和 Wiki 不会随仓库自动搬走。",
          "variant": "takeaway"
        }
      ],
      "sourceDate": "2026-11-19",
