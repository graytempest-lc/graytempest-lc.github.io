    {
      "id": "rhel-runners",
      "title": "GitHub Actions 的 RHEL 9／10 镜像正式可用",
      "titleId": "rhel-runners-title",
      "paragraphs": [
        {
          "text": "RHEL larger runner 镜像结束预览，可让 CI 更贴近生产系统，也可用作自定义镜像基础，原预览工作流无需迁移。",
          "variant": ""
        },
        {
          "text": "仅面向 Team 和 Enterprise Cloud 的 Linux x64 larger runners，不是免费标准 runner 全面新增 RHEL。",
          "variant": "takeaway"
        }
      ],
      "sourceDate": "2026-11-19",
