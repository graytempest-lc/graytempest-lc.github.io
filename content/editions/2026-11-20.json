    {
      "id": "gemini-mac-use",
      "title": "Gemini Mac 版加入隔离后台电脑操作",
      "titleId": "gemini-mac-use-title",
      "paragraphs": [
        {
          "text": "Gemini 可在隔离后台窗口处理本地文件、桌面应用和网页，用户能观察、暂停并批准关键操作。",
          "variant": ""
        },
        {
          "text": "首发仅限美国英语、18岁以上个人账户的 AI Plus／Pro／Ultra 用户，需 Apple Silicon 与 macOS 15及以上；访问本地应用不等于模型本地运行。",
          "variant": "takeaway"
        }
      ],
      "sourceDate": "2026-11-19",
      "dateLabel": "11月19日 · 公告／进展",
