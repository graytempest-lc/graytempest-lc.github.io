    {
      "id": "cursor",
      "title": "Cursor 扩展市场发现恶意 Claude Code 包",
      "titleId": "cursor-title",
      "paragraphs": [
        {
          "text": "Cursor 通报被篡改的 Claude Code 扩展尝试植入 SSH 后门，并更新受影响版本与检测指标。",
          "variant": "dek"
        },
        {
          "text": "相关用户应核对安装记录，按官方指引检查和处置；仅卸载扩展可能清不掉独立持久化组件。暂无证据表明 Anthropic 官方分发渠道受影响，不能泛化为所有 Claude Code 用户中招。",
          "variant": "takeaway"
        }
      ],
      "sourceDate": "2026-10-30",
      "dateLabel": "10 月 29 日事件 · 30 日更新",
