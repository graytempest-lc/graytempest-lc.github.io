          "icon": true
        },
        {
          "label": "Internet-Draft",
          "url": "https://datatracker.ietf.org/doc/draft-kelley-aipref-training-preference-signal/",
          "icon": true
        }
      ]
    },
    {
      "id": "suncatcher",
      "title": "Google 在轨 TPU 完成首次 AI 响应",
      "titleId": "suncatcher-title",
      "paragraphs": [
        {
          "text": "10 月 1 日发射的 Project Suncatcher 原型卫星，本周用 Gemma 4 生成短诗，完成“Hello World”。",
          "variant": ""
        },
        {
          "text": "这是验证太空计算可行性的研究里程碑，后续仍需测试辐射、热环境和互联；不是商用太空数据中心上线，也未证明成本或能效优势。",
          "variant": "takeaway"
        }
      ],
      "sourceDate": "2026-10-30",
      "dateLabel": "10 月 30 日披露",
      "eventDate": null,
      "sourcePublishedAt": null,
      "sources": [
        {
