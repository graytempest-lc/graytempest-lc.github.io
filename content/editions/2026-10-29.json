    {
      "id": "transcribe",
      "title": "本地音频转写，多了一个开放权重选择",
      "titleId": "transcribe-title",
      "paragraphs": [
        {
          "text": "NVIDIA Nemotron 3.5 Transcribe 支持 40 种语言、最长 1 小时录音及最多 8 位说话人，适合自建会议记录和音频检索。",
          "variant": "dek"
        },
        {
          "text": "它不是实时流式模型；量化版本与 NeMo-Speech.cpp 仍待推出，4B 活跃参数也不等于 4B 模型的显存需求。",
          "variant": "takeaway"
        }
      ],
      "sourceDate": "2026-10-28",
      "dateLabel": "10 月 28 日发布",
      "eventDate": null,
      "sourcePublishedAt": null,
      "sources": [
