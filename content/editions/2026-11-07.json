      ]
    },
    {
      "id": "copilot-review-api",
      "title": "Copilot代码审查设置开放API管理与来源标注",
      "titleId": "copilot-review-api-title",
      "paragraphs": [
        {
          "text": "REST和GraphQL可管理Copilot代码审查设置；评论和审查增加明确归属字段，并可查看评论报告使用的skills、MCP和自定义指令来源。",
          "variant": ""
        },
        {
          "text": "有利于维护者自动化审查配置与追踪AI评论依据。适用付费Copilot计划；企业及组织设置端点暂不支持GitHub Apps或细粒度PAT，仓库端点仍需相应Administration权限。",
          "variant": "takeaway"
        }
      ],
      "sourceDate": "2026-11-06",
      "dateLabel": "11月6日 · 开发工具",
      "eventDate": "2026-11-06",
