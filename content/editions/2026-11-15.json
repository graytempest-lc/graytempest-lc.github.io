    {
      "id": "groot2-research",
      "title": "GR00T 2 研究探索人类视频到机器人动作迁移",
      "titleId": "groot2-research-title",
      "paragraphs": [
        {
          "text": "NVIDIA 的 GR00T 2 联合预测视频与动作，尝试从人类视频学习机器人技能。",
          "variant": ""
        },
        {
          "text": "适合跟踪复现，不是现在就能部署的通用控制器：代码预计12月提供，演示成功率只适用于论文任务与训练条件，不代表跨场景可靠性。",
          "variant": "takeaway"
        }
      ],
