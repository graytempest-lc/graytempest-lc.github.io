    {
      "id": "github-advisory-role",
      "title": "GitHub 可按仓库细分安全公告职责",
      "titleId": "github-advisory-role-title",
      "paragraphs": [
        {
          "text": "GitHub 正式开放安全公告自定义权限，可分别授予查看、编辑管理、收取私有漏洞报告和发布的权限。",
          "variant": ""
        },
        {
          "text": "需支持自定义仓库角色的套餐；不等于授予管理员权限，临时私有 fork 的合并仍有额外限制。",
          "variant": "takeaway"
        }
      ],
