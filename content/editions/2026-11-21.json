    {
      "id": "windows-le-audio-winre",
      "title": "Windows 预览测试双向 LE Audio 和新的 WinRE 更新方式",
      "titleId": "windows-le-audio-winre-title",
      "paragraphs": [
        {
          "text": "Windows 11 Experimental 开始测试耳机麦克风使用时仍保持双声道 16 bit、48kHz 播放，并试行随累积更新重建恢复环境。",
          "variant": ""
        },
        {
          "text": "音频功能要求兼容的电脑和 LE Audio 设备。这是渐进推送的 Insider 预览；使用第三方磁盘加密时还需检查恢复环境驱动。",
          "variant": "takeaway"
        }
      ],
      "sourceDate": "2026-11-20",
      "dateLabel": "11月20日 · 公告／进展",
      "eventDate": null,
      "sourcePublishedAt": "2026-11-20",
