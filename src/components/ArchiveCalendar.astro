---
import {lunar2026,terms2026} from '../../public/sol3/calendar-data.mjs';
const {issues,current}=Astro.props;
const dates=new Set(issues.map(x=>x.data.editionDate));
const months=[...new Set([...dates].map(d=>d.slice(0,7)))].sort().reverse();
function cells(month){const [y,m]=month.split('-').map(Number);const n=new Date(Date.UTC(y,m,0)).getUTCDate();const offset=(new Date(Date.UTC(y,m-1,1)).getUTCDay()+6)%7;const a=Array(offset).fill(null);for(let d=1;d<=n;d++)a.push(`${month}-${String(d).padStart(2,'0')}`);while(a.length%7)a.push(null);return Array.from({length:a.length/7},(_,i)=>a.slice(i*7,i*7+7));}
const lunar=(d)=>lunar2026[d];
const label=(d)=>terms2026[d]||(lunar(d)?.lunarDay==='初一'?lunar(d).lunarMonth:lunar(d)?.lunarDay)||'';
const spoken=(d)=>`${d}${lunar(d)?'，农历'+lunar(d).lunarYear+lunar(d).lunarMonth+lunar(d).lunarDay:''}${terms2026[d]?'，'+terms2026[d]:''}`;
---
<details class="archive-menu"><summary>Sol3 日历</summary><div class="archive-list archive-calendar sol3-calendar">
 <p class="calendar-title">Sol3 本土日历</p><p class="calendar-help">公历 · 农历 · 节气 / 有底色的日期可读日报</p>
 {months.map((month,i)=><details class="calendar-month" name="archive-months" open={i===0}><summary>{Number(month.slice(0,4))} 年 {Number(month.slice(5))} 月 <span>{[...dates].filter(d=>d.startsWith(month)).length} 期</span></summary><table class="calendar-grid"><caption class="sr-only">{month} 日报日历，周一至周日</caption><thead><tr>{['一','二','三','四','五','六','日'].map(w=><th scope="col">{w}</th>)}</tr></thead><tbody>{cells(month).map(row=><tr>{row.map(d=>!d?<td class="calendar-empty" aria-hidden="true"></td>:<td>{dates.has(d)?<a href={`/${d}.html`} aria-label={`${spoken(d)}，阅读日报${d===current?'，本期':''}`} aria-current={d===current?'page':undefined}><span class="calendar-solar">{Number(d.slice(8))}</span><small class:list={['calendar-lunar',terms2026[d]&&'calendar-term']}>{label(d)}</small></a>:<><span class="calendar-unavailable" aria-hidden="true"><span class="calendar-solar">{Number(d.slice(8))}</span><small class:list={['calendar-lunar',terms2026[d]&&'calendar-term']}>{label(d)}</small></span><span class="sr-only">{spoken(d)}，暂无日报</span></>}</td>)}</tr>)}</tbody></table></details>)}
 <p class="calendar-legend"><span class="calendar-key" aria-hidden="true"></span>有日报 <span class="calendar-key-current" aria-hidden="true"></span>本期</p>
 <details class="calendar-notes"><summary>历法来源与黄历说明</summary><p>公历与农历按东八区（UTC+8）民用日对应；农历、节气目前已核对 2026 年。未核对年份不推算、不沿用旧数据。</p><p>农历数据：<a href="https://data.weather.gov.hk/weatherAPI/hko_data/calendar/nongli_calendar_2026.csv">香港天文台</a>，经 <a href="https://data.gov.hk/en-data/dataset/hk-hko-rss-gregorian-lunar-calendar-conversion-table">DATA.GOV.HK</a>。相关知识产权归香港特别行政区政府所有；<a href="https://data.gov.hk/sc/terms-and-conditions">开放数据条款</a>。</p><p>节气日期按香港天文台公布的历法事实核对。<a href="https://www.hko.gov.hk/sc/gts/time/conversion.htm">公农历对照表</a>。<a href="/sol3/sources.html">黄历来源与已核范围</a>。</p></details>
</div></details>
